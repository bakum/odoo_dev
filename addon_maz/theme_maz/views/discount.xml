<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <record id="view_maz_discount_form" model="ir.ui.view">
        <field name="name">maz.discount.form</field>
        <field name="model">maz.discount</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                         <field name="discount"/>
                         <field name="use_from"/>
                    </group>
                </sheet>
            </form>
        </field>
     </record>

    <record id="view_maz_discount_tree" model="ir.ui.view">
        <field name="name">maz.discount.tree</field>
        <field name="model">maz.discount</field>
        <field name="arch" type="xml">
            <tree>
                <field name="use_from"/>
                <field name="discount"/>
            </tree>
        </field>
    </record>

    <record id="action_maz_discount_form" model="ir.actions.act_window">
        <field name="name">Discounts</field>
        <field name="res_model">maz.discount</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_maz_discount" parent="website_sale.menu_ecommerce"
            name="Discounts"
               sequence="4">
         <menuitem id="menu_maz_discount_div"
                name="Discounts"
                action="action_maz_discount_form"
                sequence="1"/>

     </menuitem>
</odoo>