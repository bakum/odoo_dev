<!--                    <img t-attf-src="data:image/*;base64,{{category.image_1920}}"-->
<!--                            t-att-alt="category.name"-->
<!--                    />-->
<!--                <a href="#" style="background-image: url('/media/images/group/p8LCoUMK.jpg');">-->
                    <span class="tit" t-field="category.name" t-nocache="Name"/>
                    <span class="cat" t-nocache="Name">VFP</span>
                </a>
            </t>

