<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="custom_snippets" inherit_id="website.snippets" name="Custom Snippets">
        <xpath expr="//div[@id='snippet_effect']//t[@t-snippet][last()]"
               position="after">
<!--            <div id="snippet_structure" class="o_panel">-->
<!--                <div class="o_panel_header">Категорії товарів (МАЗ)</div>-->
<!--                <div class="o_panel_body">-->
                    <t t-snippet="theme_maz.categories_tile" t-thumbnail="/theme_maz/static/src/img/snippets/categories.svg">
                        <keywords>property, agents</keywords>
                    </t>
<!--                </div>-->
<!--            </div>-->
        </xpath>
    </template>
    <template id="custom_contacts_snippets" inherit_id="website.snippets" name="Custom Snippets">
        <xpath expr="//div[@id='snippet_structure']//t[@t-snippet][last()]"
               position="after">
<!--            <div id="snippet_structure" class="o_panel">-->
<!--                <div class="o_panel_header">Категорії товарів (МАЗ)</div>-->
<!--                <div class="o_panel_body">-->
                    <t t-snippet="theme_maz.maz_contacts" t-thumbnail="/theme_maz/static/src/img/snippets/s_media_list.svg">
                    </t>
<!--                </div>-->
<!--            </div>-->
        </xpath>
    </template>

    <template id="categories_options" inherit_id="website.snippet_options" name="Maz Catalogies Options">
    <xpath expr="//div[@data-js='Box']" position="after">
        <div data-selector=".categories_tile" data-js="MazCategories" data-drop-in=".o_mega_menu nav">
<!--            <we-select string="Company Name">-->
<!--                <we-button data-select-class="categories-visible">Visible</we-button>-->
<!--                <we-button data-select-class="categories-hidden">Hidden</we-button>-->
<!--            </we-select>-->
        </div>
    </xpath>
    </template>

    <template id="contacts_options" inherit_id="website.snippet_options" name="Maz Contacts Options">
    <xpath expr="//div[@data-js='Box']" position="after">
        <div data-selector=".maz_contacts">
            <we-select string="City Name">
                <we-button data-select-class="city-visible">Visible</we-button>
                <we-button data-select-class="city-hidden">Hidden</we-button>
            </we-select>
        </div>
    </xpath>
    </template>
</odoo>
