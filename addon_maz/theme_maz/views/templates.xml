<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="theme_maz.header_text_element" inherit_id="website.placeholder_header_text_element"
              name="Header Text element" active="True">
        <xpath expr="." position="inside">
            <li t-attf-class="#{_item_class}">
                <div t-attf-class="s_text_block #{_div_class} #{'d-flex flex-column flex-lg-row gap-1 gap-lg-4 align-items-lg-center' if _txt_elt_content == 'list' else ''}"
                     data-name="Text">
                    <t t-if="_txt_elt_content == 'sentence'">
                        <div class="f">
                            <p data-block-key="wgw53">Ціни на запчастини МАЗ</p>
                        </div>
                        <div class="t">
                            <p data-block-key="9cbdi">Інтернет магазин 050-484-71-80,
                                Полтава 095-234-21-14,<br/> Запоріжжя 050-361-90-78, Кривий
                                Ріг 050-580-48-46
                            </p>
                        </div>
                    </t>
<!--                    <t t-elif="_txt_elt_content == 'list'">-->
<!--                        <small class="d-flex align-items-center">-->
<!--                            <i class="fa fa-1x fa-fw fa-usd fa-stack me-1"/>-->
<!--                            Low Price Guarantee-->
<!--                        </small>-->
<!--                        <small class="d-flex align-items-center">-->
<!--                            <i class="fa fa-1x fa-fw fa-shopping-basket fa-stack me-1"/>-->
<!--                            30 Days Online Returns-->
<!--                        </small>-->
<!--                        <small class="d-flex align-items-center">-->
<!--                            <i class="fa fa-1x fa-fw fa-truck fa-stack me-1"/>-->
<!--                            Standard Shipping-->
<!--                        </small>-->
<!--                    </t>-->
                    <t t-elif="_txt_elt_content == 'phone_mail'">
                        <a href="tel:+1 (650) 555-0111" t-attf-class="nav-link o_nav-link_secondary #{_link_class}">
                            <small>
                                <i class="fa fa-1x fa-fw fa-phone me-1"/>&#847; <!-- Empty character needed to be able to delete the icon. -->
                                <span class="o_force_ltr">+1 (650) 555-0111</span>
                            </small>
                        </a>
                        <a href="mailto:info@yourcompany.example.com"
                           t-attf-class="nav-link o_nav-link_secondary #{_link_class}">
                            <small>
                                <i class="fa fa-1x fa-fw fa-envelope me-1"/>
                                info@yourcompany.example.com
                            </small>
                        </a>
                    </t>
                    <t t-elif="_txt_elt_content == 'mail'">
                        <a href="mailto:info@yourcompany.example.com"
                           t-attf-class="nav-link o_nav-link_secondary #{_link_class}">
                            <small>
                                <i class="fa fa-1x fa-fw fa-envelope me-1"/>
                                info@yourcompany.example.com
                            </small>
                        </a>
                    </t>
                    <t t-else="">
                        <a href="tel:+1 (650) 555-0111" t-attf-class="nav-link o_nav-link_secondary p-2 #{_link_class}">
                            <i class="fa fa-1x fa-fw fa-phone me-1"/>
                            <span class="o_force_ltr">
                                <small>+1 (650) 555-0111</small>
                            </span>
                        </a>
                    </t>
                </div>
            </li>
        </xpath>
    </template>
</odoo>
