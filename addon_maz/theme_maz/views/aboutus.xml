<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="custom_aboutus" inherit_id="website.aboutus" name="About Us">
        <xpath expr="//t[@t-call='website.layout']" position="replace">
            <t t-call="website.layout">
                <div class="container body-md">
                    <div class="row">
                        <div class="col-lg-3 col-md-3 col-sm-4 col-xs-12 cont_left">
                            <t t-call="website.navbar_nav">
                                <t t-set="_nav_class" t-valuef="me-auto"/>

                                <!-- Menu -->
                                <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                    <t t-call="website.submenu">
                                        <!--                                            <t t-set="item_class" t-valuef="mmen"/>-->
                                        <t t-set="link_class" t-valuef="mmen"/>
                                    </t>
                                </t>
                            </t>
                        </div>
                        <div class="col-lg-9 col-md-9 col-sm-8 col-xs-12 cont_right">
                            <div id="wrap">
                                <div class="oe_structure">
<!--                                    <section class="s_title parallax s_parallax_is_fixed bg-black-50 pt24 pb24" data-vcss="001" data-snippet="s_title" data-scroll-background-ratio="1">-->
<!--                                        <span class="s_parallax_bg oe_img_bg" style="background-image: url('/web/image/website.s_parallax_default_image'); background-position: 50% 0;"/>-->
<!--                                        <div class="o_we_bg_filter bg-black-50"/>-->
                                        <div class="page_title">
                                            About us
                                        </div>
<!--                                    </section>-->
                                </div>
                                <div class="oe_structure"/>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <record id="page_aboutus" model="theme.website.page">
        <field name="view_id" ref="custom_aboutus"/>
        <field name="is_published" eval="True"/>
        <field name="url">/aboutus</field>
    </record>
</odoo>
