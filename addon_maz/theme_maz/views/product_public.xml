<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_product_public_form_inherit_maz" model="ir.ui.view">
            <field name="name">product.public.form.inherit.maz</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='uom_po_id']" position="after">
                        <field name="guid" readonly="1"/>
                    </xpath>
                </data>
            </field>
        </record>

        <record id="view_product_public_tree_inherit_maz" model="ir.ui.view">
            <field name="name">product.public.tree.inherit.maz</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='standard_price']" position="after">
                        <field name="guid" readonly="1" optional="hide"/>
                    </xpath>
                </data>
            </field>
        </record>

        <record id="view_product_public_category_form_inherit_maz" model="ir.ui.view">
            <field name="name">product.public.category.form.inherit.maz</field>
            <field name="model">product.public.category</field>
            <field name="inherit_id" ref="website_sale.product_public_category_form_view"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//sheet" position="inside">
                        <field name="active" invisible="1"/>
                        <div class="oe_button_box" name="button_box"/>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                                invisible="active == True"/>
                    </xpath>
                    <xpath expr="//field[@name='sequence']" position="after">
                        <field name="guid" readonly="1"/>
                        <field name="brand"/>
                    </xpath>
                </data>
            </field>
        </record>

        <record id="view_product_public_category_tree_inherit_maz" model="ir.ui.view">
            <field name="name">product.public.category.tree.inherit.maz</field>
            <field name="model">product.public.category</field>
            <field name="inherit_id" ref="website_sale.product_public_category_tree_view"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='display_name']" position="after">
                        <field name="guid" readonly="1" optional="hide"/>
                    </xpath>
                </data>
            </field>
        </record>

        <record id="view_product_public_search" model="ir.ui.view">
            <field name="name">product.public.category.search</field>
            <field name="model">product.public.category</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" filter_domain="[('name', 'ilike', self)]"/>
                    <separator/>
                    <filter name="filter_archived" string="Archived" domain="[('active','=',False)]"/>
                </search>
            </field>
        </record>

    </data>
</odoo>
