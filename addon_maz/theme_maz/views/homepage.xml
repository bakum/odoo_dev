<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="custom_homepage" inherit_id="website.homepage" name="Home">
        <xpath expr="//t[@t-call='website.layout']" position="replace">
            <t t-call="website.layout">
                <t t-set="pageName" t-value="'homepage'"/>
                <!--                <div class="oe_structure"/>-->
                <div class="container body-md">
                    <div class="row">
                        <div class="col-lg-3 col-md-3 col-sm-4 col-xs-12 cont_left">
                            <t t-call="website.navbar_nav">
                                <t t-set="_nav_class" t-valuef="me-auto"/>

                                <!-- Menu -->
                                <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                    <t t-call="website.submenu">
                                        <!--                                            <t t-set="item_class" t-valuef="mmen"/>-->
                                        <t t-set="link_class" t-valuef="mmen"/>
                                    </t>
                                </t>
                            </t>
                        </div>
                        <div class="col-lg-9 col-md-9 col-sm-8 col-xs-12 cont_right">
                            <div id="wrap" class="oe_structure oe_empty"/>

                            <div class="oe_structure"/>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
