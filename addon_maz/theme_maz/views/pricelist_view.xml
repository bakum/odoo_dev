<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_pricelist_maz_form_inherit" model="ir.ui.view">
            <field name="name">product.pricelist.form.inherit.maz</field>
            <field name="model">product.pricelist</field>
            <field name="inherit_id" ref="product.product_pricelist_view"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//group[@name='pricelist_availability']" position="after">
                        <group name="pricelist_maz" string="Synchronization">
                            <field name="guid" readonly="1"/>
                        </group>
                    </xpath>
                </data>
            </field>
        </record>
    </data>
</odoo>
