<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="custom_header" inherit_id="website.layout" name="Custom Header">
        <xpath expr="//header" position="replace">
            <header id="top" data-name="Header">
                <t t-call="website.navbar">
<!--                    <t t-set="_navbar_classes" t-valuef="d-none d-lg-block shadow-sm"/>-->
                    <div class="header_line1">
<!--                        <div class="container h100pro">-->
                        <div id="o_main_nav" class="container h100pro">
                            <div class="row bgwhite">
                                <div class="col-lg-3 col-md-3 col-sm-4 col-xs-12 " style="height: 150px;">
<!--                                    <a data-name="Navbar Logo" href="/" class ="navbar-brand logo">-->
<!--                                        <span t-field="website.logo"-->
<!--                                              t-options="{'widget': 'image', 'width': 160, 'height': 160}"-->
<!--                                              role="img"-->
<!--                                              t-att-aria-label="'Logo of %s' % website.name"-->
<!--                                              t-att-title="website.name"/>-->
<!--                                    </a>-->
                                    <t t-call="website.placeholder_header_brand">
                                        <t t-set="_link_class" t-valuef="navbar-brand logo" />
                                    </t>
                                </div>

                                <div class="col-lg-9 col-md-9 col-sm-8 col-xs-12 header_ttb">
                                    <div class="row">
                                        <div class="col-lg-9 col-md-8 col-sm-8 col-xs-12 header_min"
                                             style="height: 150px;">
                                            <table cellspacing="0" cellpadding="0" style="height: 150px;">
                                                <tbody>
                                                    <tr>
                                                        <td class="ttb1">
                                                            <t t-call="website.placeholder_header_language_selector">
                                                                <t t-set="_btn_class" t-valuef="btn-primary border-0"/>
                                                                <t t-set="_txt_class" t-valuef="small"/>
                                                                <t t-set="_dropdown_menu_class"
                                                                   t-valuef="dropdown-menu-end"/>
                                                            </t>
                                                        </td>
                                                        <td class="ttb2">
                                                            <!-- Sign In -->
                                                            <t t-call="portal.placeholder_user_sign_in">
                                                                <t t-set="_link_class" t-valuef="btn btn-primary"/>
                                                            </t>
                                                            <!-- User Dropdown -->
                                                            <t t-call="portal.user_dropdown">
                                                                <t t-set="_user_name" t-value="True"/>
                                                                <t t-set="_item_class" t-valuef="dropdown"/>
                                                                <t t-set="_link_class" t-valuef="btn-primary border-0"/>
                                                                <t t-set="_user_name_class" t-valuef="small"/>
                                                                <t t-set="_dropdown_menu_class"
                                                                   t-valuef="dropdown-menu-end"/>
                                                            </t>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td colspan="2" width="78%" class="ttb5 ttb9">
                                                            <t t-call="website.placeholder_header_text_element">
                                                                <t t-set="_txt_elt_content" t-valuef="sentence"/>
                                                                <!--                                                            <t t-set="_div_class" t-valuef="d-flex align-items-center mx-auto"/>-->
                                                                <!--                                                            <t t-set="_item_class" t-valuef="d-flex align-items-center"/>-->
                                                            </t>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                        <div class="col-lg-3 col-md-4 col-sm-4 col-xs-12 header_cart"
                                             style="height: 150px;">
                                            <table cellspacing="0" cellpadding="0" style="height: 150px;">
                                                <tbody>
                                                    <tr>
                                                        <td width="22%" rowspan="2" class="ttb3">

                                                            <t t-call="website_sale.header_cart_link">
                                                                <t t-set="_icon" t-value="False"/>
                                                                <t t-set="_link_class"
                                                                   t-value="'top_cart_bt btn position-relative rounded-circle p-1 text-reset'"/>
                                                                <t t-set="_badge_class"
                                                                   t-value="'position-absolute top-0 end-0 mt-n1 me-n1 rounded-pill'"/>
                                                            </t>
                                                            <!--                                                        <div class="top_cart1">У кошику:</div>-->
                                                            <!--                                                        <span id="cart_in_text">-->
                                                            <!--                                                            <div class="top_cart2">пусто</div>-->
                                                            <!--                                                            <div class="top_cart3"></div>-->
                                                            <!--                                                        </span>-->
                                                            <!--                                                        <a href="/uk/cart/cart-detail/" class="top_cart_bt">-->
                                                            <!--                                                            <span>Кошик</span>-->
                                                            <!--                                                        </a>-->
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
                <div class="header_line2">
                    <div class="container h100pro">
                        <div class="row bgwhite">
                            <div class="col-lg-3 col-md-3 col-sm-4 col-xs-12 hidden-xs header_raz">
                                <span><p data-block-key="anh8v">Розділи</p></span>
                            </div>
                            <div class="col-lg-9 col-md-9 col-sm-8 col-xs-12 header_search">
                                <table cellspacing="0" cellpadding="0">
                                    <tr>
                                        <td class="ttb10">
                                            <t t-call="website.placeholder_header_search_box">
<!--                                                <t t-set="_layout" t-valuef="modal"/>-->
                                                <t t-set="_input_classes" t-valuef="border p-2"/>
<!--                                                <t t-set="_submit_classes" t-valuef="border border-start-0 px-4 bg-o-color-4"/>-->
<!--                                                <t t-set="_button_classes" t-valuef="o_navlink_background text-reset"/>-->
                                            </t>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </header>
<!--            <t t-call="website.template_header_mobile">-->
<!--                <t t-set="_txt_elt_content" t-valuef="phone_mail"/>-->
<!--            </t>-->
        </xpath>
    </template>
</odoo>
