<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_sync_nova_poshta_catalog" model="ir.cron">
            <field name="name">>Nova Poshta: synchronization of catalogs</field>
            <field name="model_id" ref="model_nova_poshta_config"/>
            <field name="state">code</field>
            <field name="code">model.sync_catalogs()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name='interval_number'>1</field>
            <field name='interval_type'>months</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
        </record>

        <record id="product_product_nova_poshta_delivery" model="product.product">
            <field name="name">Nova Poshta</field>
            <field name="default_code">Delivery_NP</field>
            <field name="type">service</field>
            <field name="categ_id" ref="delivery.product_category_deliveries"/>
            <field name="sale_ok" eval="False"/>
            <field name="purchase_ok" eval="False"/>
<!--            <field name="country_ids" eval="[(6, 0, [ref('base.uk')])]"/>-->
            <field name="list_price">0.0</field>
            <field name="invoice_policy">order</field>
        </record>

        <record id="delivery_nova_poshta" model="delivery.carrier">
            <field name="name">Nova Poshta</field>
            <field name="delivery_type">fixed</field>
            <field name="product_id" ref="nova_poshta_base.product_product_nova_poshta_delivery"/>
        </record>
    </data>
</odoo>