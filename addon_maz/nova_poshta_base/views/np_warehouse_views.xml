<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nova_poshta_warehouse_view_form" model="ir.ui.view">
        <field name="name">nova.poshta.warehouse.view.form</field>
        <field name="model">nova.poshta.warehouse</field>
        <field name="arch" type="xml">
            <form edit="false" create="false">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h3>
                            <field name="name" placeholder="Warehouse Name"/>
                        </h3>
                    </div>
                    <group>
                        <field name="name_ru"/>
                        <field name="site_key"/>
                        <field name="type"/>
                        <field name="number"/>
                    </group>
                    <group>
                        <field name="city_ref"/>
                        <field name="city_description"/>
                        <field name="city_description_ru"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="nova_poshta_warehouse_view_tree" model="ir.ui.view">
        <field name="name">nova.poshta.warehouse.view.tree</field>
        <field name="model">nova.poshta.warehouse</field>
        <field name="arch" type="xml">
            <tree edit="false" create="false">
                <field name="city_description"/>
                <field name="number"/>
                <field name="name"/>
                <field name="write_date" string="Updated"/>
            </tree>
        </field>
    </record>
    <record id="nova_poshta_warehouse_view_search" model="ir.ui.view">
        <field name="name">nova.poshta.warehouse.view.search</field>
        <field name="model">nova.poshta.warehouse</field>
        <field name="arch" type="xml">
            <search string="Search Warehouses">
                <field name="name" string="Name" filter_domain="['|',('name','ilike',self),('name_ru','ilike',self)]"/>
                <field name="city_description" string="City"
                       filter_domain="['|',('city_description','ilike',self),('city_description_ru','ilike',self)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_by_city" string="City" context="{'group_by':'city_description'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <record id="action_nova_poshta_warehouse_tree" model="ir.actions.act_window">
        <field name="name">Warehouses</field>
        <field name="res_model">nova.poshta.warehouse</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>