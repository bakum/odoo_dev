<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nova_poshta_area_view_form" model="ir.ui.view">
        <field name="name">nova.poshta.area.view.form</field>
        <field name="model">nova.poshta.area</field>
        <field name="arch" type="xml">
            <form edit="false" create="false">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h3>
                            <field name="name" placeholder="Area Name"/>
                        </h3>
                    </div>
                    <group>
                        <field name="ref"/>
                        <field name="center"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nova_poshta_area_view_tree" model="ir.ui.view">
        <field name="name">nova.poshta.area.view.tree</field>
        <field name="model">nova.poshta.area</field>
        <field name="arch" type="xml">
            <tree edit="false" create="false">
                <field name="name"/>
                <field name="ref"/>
                <field name="center"/>
            </tree>
        </field>
    </record>

    <record id="action_nova_poshta_area_tree" model="ir.actions.act_window">
        <field name="name">Areas</field>
        <field name="res_model">nova.poshta.area</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>