<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nova_poshta_config_view_form" model="ir.ui.view">
        <field name="name">nova.poshta.config.view.form</field>
        <field name="model">nova.poshta.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sync_catalogs" string="Sync catalogs" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h3>
                            <field name="name" placeholder="Account Name"/>
                        </h3>
                    </div>
                    <group>
                        <field name="key" groups="base.group_system"/>
                        <field name="url"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nova_poshta_config_tree" model="ir.actions.act_window">
        <field name="name">Nova Poshta Accounts</field>
        <field name="res_model">nova.poshta.config</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>