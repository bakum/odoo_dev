<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nova_poshta_settlement_view_form" model="ir.ui.view">
        <field name="name">nova.poshta.settlement.view.form</field>
        <field name="model">nova.poshta.settlement</field>
        <field name="arch" type="xml">
            <form edit="false" create="false">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h3>
                            <field name="name" placeholder="Warehouse Name"/>
                        </h3>
                    </div>
                    <group>
                        <field name="type"/>
                        <field name="area"/>
                        <field name="area_id"/>
                        <field name="index_1"/>
                        <field name="index_2"/>
                    </group>
                    <group>
                        <field name="region"/>
                        <field name="region_description"/>
                        <field name="region_description_ru"/>
                    </group>
                    <group string="Delivery Days" name="delivery">
                        <field name="delivery_1"/>
                        <field name="delivery_2"/>
                        <field name="delivery_3"/>
                        <field name="delivery_4"/>
                        <field name="delivery_5"/>
                        <field name="delivery_6"/>
                        <field name="delivery_7"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="nova_poshta_settlement_view_tree" model="ir.ui.view">
        <field name="name">nova.poshta.settlement.view.tree</field>
        <field name="model">nova.poshta.settlement</field>
        <field name="arch" type="xml">
            <tree edit="false" create="false">
                <field name="index_1"/>
                <field name="index_2"/>
                <field name="name"/>
                <field name="area_id"/>
                <field name="type"/>
                <field name="write_date" string="Updated"/>
            </tree>
        </field>
    </record>
    <record id="nova_poshta_settlement_view_search" model="ir.ui.view">
        <field name="name">nova.poshta.settlement.view.search</field>
        <field name="model">nova.poshta.settlement</field>
        <field name="arch" type="xml">
            <search string="Search Settlements">
                <field name="name" string="Name" filter_domain="['|',('name','ilike',self),('name_ru','ilike',self)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_region" string="Region" domain="[]"
                            context="{'group_by':'region_description'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nova_poshta_settlement_tree" model="ir.actions.act_window">
        <field name="name">Settlements</field>
        <field name="res_model">nova.poshta.settlement</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>