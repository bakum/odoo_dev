<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_distrib_invoice" model="ir.actions.report">
        <field name="name">Proforma (UGears)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ug_wholesale_shop.report_distrib_invoice</field>
        <field name="report_file">ug_wholesale_shop.report_distrib_invoice</field>
        <field name="print_report_name">'Proforma - %s' % (object.source_order_name or object.name)</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="ug_wholesale_shop.ug_wholesale_shop_paperformat_a4_invoice"/>
    </record>

