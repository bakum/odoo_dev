<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">

<t t-name="ImportOrder.Buttons" t-inherit="web.ListView.Buttons" t-inherit-mode="primary" owl="1">
    <xpath expr="(//div/*)[last()]" position="after">
        <button
                class="btn btn-secondary px-4" type="button" t-on-click="onClickImportOrder">
            Import an order
        </button>
    </xpath>
</t>

</templates>