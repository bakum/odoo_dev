<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">

<t t-name="ImportOrder.Buttons" t-inherit="web.ListView.Buttons" t-inherit-mode="primary" owl="1">
    <xpath expr="(//div/*)[last()]" position="after">
        <button
                class="btn btn-secondary px-4 text-nowrap o_button_import" type="button" t-on-click="onClickImportOrder">
            Import an order
        </button>
        <button type="button" class="btn btn-outline-primary ms-2 text-nowrap o_download_template"
                title="Import Template for Distribution Order" t-on-click="OnDownload">
            <i class="fa fa-download me-1"/>Order template
        </button>
        <button type="button" class="btn btn-outline-primary ms-2 text-nowrap o_download_pricelist"
                title="Download price list" t-on-click="OnDownloadPricelist">
            <i class="fa fa-download me-1"/>Price list
        </button>
    </xpath>
</t>

</templates>