<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="distrib_distributors_orders_rule" model="ir.rule">
            <field name="name">Distributor Orders</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">['&amp;',('partner_id.id', '=', user.distrib_id.partner_id.id),('website_id', '!=', False)]</field>
            <field name="groups" eval="[(4, ref('ug_base_distrib.group_distrib_user'))]"/>
        </record>
        <record id="distrib_manager_orders_rule" model="ir.rule">
            <field name="name">Distributor All Web Orders</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[('website_id', '!=', False)]</field>
            <field name="groups" eval="[(4, ref('ug_base_distrib.group_distrib_manager'))]"/>
        </record>
    </data>
</odoo>