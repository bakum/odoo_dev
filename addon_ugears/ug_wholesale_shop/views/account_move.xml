<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_account_move_form_inherit_distrib" model="ir.ui.view">
            <field name="name">account.move.form.inherit.distrib</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='qr_code_method']" position="before">
                        <field name="bank_customer_id" invisible="1"/>
                        <field name="customer_bank_id" context="{'default_customer_bank_id': bank_customer_id}" domain="[('partner_id', '=', bank_customer_id)]" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                    </xpath>
                </data>
            </field>
        </record>
    </data>
</odoo>