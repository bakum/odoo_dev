<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_account_move_form_inherit_distrib" model="ir.ui.view">
            <field name="name">account.move.form.inherit.distrib</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='qr_code_method']" position="before">
                        <field name="bank_beneficiary_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        <field name="beneficiary_bank_id" context="{'default_partner_id': bank_beneficiary_id, 'default_currency_id': currency_id}" domain="['&amp;',('partner_id', '=', bank_beneficiary_id),('currency_id', '=', currency_id)]" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        <field name="bank_customer_id" invisible="1"/>
                        <field name="customer_bank_id" context="{'default_partner_id': bank_customer_id, 'default_currency_id': currency_id}" domain="['&amp;',('partner_id', '=', bank_customer_id),('currency_id', '=', currency_id)]" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                    </xpath>
                    <xpath expr="//field[@name='to_check']" position="after">
                        <field name="date_facture"/>
                        <field name="number_facture"/>
                        <field name="source_order_name" readonly="1"/>
                    </xpath>
                    <xpath expr="//field[@name='tax_totals']" position="after">
                        <field name="amount_qty"/>
                    </xpath>
                </data>
            </field>
        </record>

        <record id="view_account_move_tree_inherit_distrib" model="ir.ui.view">
            <field name="name">account.move.tree.inherit.distrib</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_out_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="source_order_name" optional="show"/>
                </xpath>
            </field>
        </record>

        <record id="view_account_invoice_filter_inherit_distrib" model="ir.ui.view">
            <field name="name">account.invoice.select.inherit.distrib</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_user_id']" position="after">
                    <field name="source_order_name" string="Source Order"/>
                </xpath>
            </field>
        </record>

        <record id="view_distributor_bank_form_inherit_account" model="ir.ui.view">
            <field name="name">res.distrib.bank.form.inherit.account</field>
            <field name="model">res.partner.bank</field>
            <field name="inherit_id" ref="base.view_partner_bank_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="currency_id"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>