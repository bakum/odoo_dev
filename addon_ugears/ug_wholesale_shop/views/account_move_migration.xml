<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="action_migrate_invoice_prefix" model="ir.actions.server">
        <field name="name">Migrate Invoice Prefix</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">action = env['account.move'].migrate_invoice_prefix()</field>
    </record>

    <!-- Кнопка на форме account.move -->
    <record id="view_move_form_migrate_prefix" model="ir.ui.view">
        <field name="name">account.move.form.prefix.migration</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="migrate_invoice_prefix"
                        type="object"
                        string="Migrate Prefix"
                        class="btn-primary"
                        attrs="{'invisible': [('move_type', '!=', 'out_invoice')]}"/>
            </header>
        </field>
    </record>
    </data>
</odoo>