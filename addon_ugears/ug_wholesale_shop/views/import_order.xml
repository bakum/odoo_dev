<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ug_import_order_from_xls_view" model="ir.ui.view">
            <field name="name">Import order</field>
            <field name="model">ug.wholesale.import.order</field>
            <field name="arch" type="xml">
                <form string="Import order">
<!--                     <header>-->
<!--                          <button string="Load order from Excel" name="load_order_from_xls" class="oe_highlight" type="object"-->
<!--                                attrs="{'invisible': [('xls_filename', '=', False)]}"/>-->
<!--                    </header>-->
                    <sheet>
                        <div class="oe_title pb-4">
                            <H3>
                                <field name="name" readonly="1"/>
                            </H3>
                        </div>
                        <field name="len_products" invisible="1"/>
                        <group>
                            <group>
                                <field name="xls_filename" invisible="1"/>
                                <field name="xls_file" filename="xls_filename"/>
                            </group>
                            <group>
                                 <field name="date_order"/>
                                <field name="distrib_id" widget="many2one" options="{'no_create': True, 'no_open': True}"/>
                            </group>
                        </group>
                        <div class="o_statusbar_buttons d-flex align-items-center align-content-around flex-wrap">
                            <button string="Load order from Excel" name="load_order_from_xls" class="oe_highlight" type="object"
                                attrs="{'invisible': [('xls_filename', '=', False)]}"/>
                        </div>
                        <notebook>
                            <page string="Products">
                                <field name="products_ids">
                                    <tree create="false" editable="top">
<!--                                        <field name="name" readonly="1"/>-->
                                        <field name="barcode" readonly="1"/>
                                        <field name="default_code" readonly="1"/>
                                        <field name="product_id" widget="many2one" options="{'no_create': True, 'no_open': True}" attrs="{'readonly': [('product_id', '!=', False)]}"/>
<!--                                        <field name="product_template_id"/>-->
                                        <field name="description" readonly="1" optional="hide"/>
                                        <field name="qtt"/>
                                        <field name="qtt_by_box"/>
                                    </tree>
                                </field>
                                 <group name="note_group" col="6" class="mt-2 mt-md-0">
                                    <!--   <group colspan="4">
                                           <field colspan="2" name="note" nolabel="1" placeholder="Terms and conditions..."/>
                                       </group> -->
                                    <group class="oe_subtotal_footer oe_right" colspan="2">
                                        <field name="total_qtt" decoration-bf="total_qtt >= 0" colspan="2"
                                               readonly="1"/>
                                    </group>
                                    <div class="clearfix"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <footer>
                        <button string="Save order" name="save_order" class="oe_highlight" type="object"
                                attrs="{'invisible': [('len_products', '=', 0)]}"/>
<!--                        <button string="Cancel" name="cancel_order" class="oe_highlight" type="object" default_focus="1"/>-->
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_import_order" model="ir.actions.act_window">
            <field name="name">Import order</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ug.wholesale.import.order</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="ug_import_order_from_xls_view"/>
            <field name="target">new</field>
        </record>

        <record id="view_ug_import_order_tree" model="ir.ui.view">
            <field name="name">ug.import.order.tree.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_tree"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//tree" position="attributes">
                        <attribute name="js_class">import_order_list</attribute>
                    </xpath>
                </data>
            </field>
        </record>
    </data>
</odoo>