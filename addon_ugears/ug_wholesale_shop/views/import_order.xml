<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ug_import_order_from_xls_view" model="ir.ui.view">
            <field name="name">Import order</field>
            <field name="model">ug.wholesale.import.order</field>
            <field name="arch" type="xml">
                <form string="Import order">
                    <sheet>
                        <div class="oe_title pb-4">
                            <H3>
                                <field name="name" readonly="1"/>
                            </H3>
                        </div>
                        <group>
                            <field name="xls_filename" invisible="1"/>
                            <field name="xls_file" filename="xls_filename"/>
                        </group>
                        <notebook>
                            <page string="Products">
                                <field name="products_ids">
                                    <tree create="false" editable="top">
<!--                                        <field name="name" readonly="1"/>-->
                                        <field name="barcode" readonly="1"/>
                                        <field name="description" readonly="1"/>
                                        <field name="product_id" widget="many2one" options="{'no_create': True, 'no_open': True}" attrs="{'readonly': [('product_id', '!=', False)]}"/>
                                        <field name="qtt"/>
                                        <field name="qtt_by_box"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
<!--                    <footer>-->
<!--                        <button string="Load order" name="load_order_from_xls" class="oe_highlight" type="object" default_focus="1"/>-->
<!--&lt;!&ndash;                                attrs="{'invisible': [('xls_filename', '=', False)]}" &ndash;&gt;-->
<!--&lt;!&ndash;                                default_focus="1"/>&ndash;&gt;-->
<!--                    </footer>-->
                </form>
            </field>
        </record>

        <record id="action_import_order" model="ir.actions.act_window">
            <field name="name">Import order</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ug.wholesale.import.order</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="ug_import_order_from_xls_view"/>
            <field name="target">new</field>
        </record>

        <record id="view_ug_import_order_tree" model="ir.ui.view">
            <field name="name">ug.import.order.tree.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_tree"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//tree" position="attributes">
                        <attribute name="js_class">import_order_list</attribute>
                    </xpath>
                </data>
            </field>
        </record>
    </data>
</odoo>