    <template id="distrib_cart_lines" inherit_id="website_sale.cart_lines" name="Shopping Cart Lines">
        <xpath expr='//input[hasclass("quantity")]' position="attributes">
            <attribute name="t-att-data-qty-in-cartoon">line.product_id.qty_in_cartoon</attribute>
        </xpath>
        <xpath expr='//th[hasclass("td-qty")]' position="after">
            <th class="text-center td-packaging">
                <t t-if="show_qty">
                    <span>Boxes</span>
                </t>
            </th>
        </xpath>
        <xpath expr='//td[hasclass("td-qty")]' position="after">
            <t t-set="package_qtt" t-value="int((int(line.product_uom_qty) == line.product_uom_qty and int(line.product_uom_qty) or line.product_uom_qty)//int(line.product_id.qty_in_cartoon))"/>
            <td class="text-center td-packaging">
                <t t-if="show_qty">
                    <span id="package_qtt" t-out="package_qtt"/>
                </t>
            </td>
        </xpath>
    </template>
