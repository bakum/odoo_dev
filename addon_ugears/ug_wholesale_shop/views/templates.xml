    <template id="distrib_product" inherit_id="website_sale.product_quantity" name="Product">
        <xpath expr='//input[hasclass("quantity")]' position="attributes">
            <attribute name="t-att-data-qty-in-cartoon">product.qty_in_cartoon</attribute>
            <attribute name="t-att-value">product.qty_in_cartoon</attribute>
        </xpath>
    </template>

    <template id="distrib_product_package" inherit_id="website_sale.product" name="Product">
         <xpath expr='//div[@id="product_attributes_simple"]' position="before">
             <div id="o_product_packages">
                 <t t-set="package_box" t-value="product.cartoon_id"/>
                 <t t-set="package_detail" t-value="product._get_package_detail()"/>
                 <t t-set="brutto_package_detail" t-value="product._get_package_detail_with_cartoon()"/>
                 <table t-attf-class="table table-sm text-muted {{'' if product.cartoon_id else 'd-none'}}">
                     <thead>
                         <tr>
                             <th>Packaging information</th>
                             <th>Box size, mm</th>
                         </tr>
                     </thead>
                     <tbody>
                         <tr>
                             <td>
                                 <span t-out="package_detail"/><br/>
                                 <span t-out="brutto_package_detail"/>
                             </td>
                             <td>
                                 <span t-field="package_box.name"/><br/>
                                 <span t-field="product.qty_in_cartoon"/>
                                 pcs per box
                             </td>
                         </tr>
                     </tbody>
                 </table>
             </div>
        </xpath>
    </template>
</odoo>