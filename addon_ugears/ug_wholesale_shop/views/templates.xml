                    <h3>
                        <span>Packing List</span>
                    </h3>
                    <div class="btn-toolbar flex-nowrap align-items-center justify-content-between mb-2">
                        <t t-call="ug_wholesale_shop.palette_list" t-cache="palette">
                            <t t-set="_classes" t-valuef="d-none d-lg-inline ms-3"/>
                        </t>
                    </div>
                    <div class="row mb16">
                        <div class="col-7 oe_cart">
                            <t t-call="ug_wholesale_shop.packing_list_lines"/>
                        </div>
                        <div class="col-5">
                            <t t-call="ug_wholesale_shop.palettes_list_lines">
                            </t>
<!--                            <t t-call="website_sale.short_cart_summary">-->
<!--                            </t>-->
                        </div>
                        <!--                        <div class="col-12 col-xl-auto">-->
                        <!--                            <t t-call="website_sale.short_cart_summary">-->
                        <!--                            </t>-->
                        <!--                        </div>-->
                    </div>
<!--                    <t t-set="redirect_url"-->
<!--                       t-value="'/web/login?redirect=/shop/confirm_order' if redirect_to_sign_in else '/shop/confirm_order'"/>-->
                    <div class="d-flex justify-content-start">
                        <div>
                            <a role="button" href="/shop/cart" class="btn btn-secondary mb32">
                                <span class="fa fa-shopping-cart"/>
                                <span>
                                    <span class="d-none d-md-inline">Back to cart</span>
                                </span>
                            </a>
                        </div>
                        <div class="d-flex flex-column ml16">
                            <a class="btn btn-primary float-end" role="button" href="/shop">
                                <span>Shopping</span>
                                <span class="fa fa-shopping-bag"/>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="oe_structure" id="oe_structure_website_sale_cart_2"/>
            </div>
        </t>
    </template>

