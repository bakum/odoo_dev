<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="distrib_header_cart_link" inherit_id="website_sale.header_cart_link" name="Header Cart Link">
        <xpath expr="//t[@t-set='show_cart']" position="after">
            <t t-set="show_cart" t-value="request.website.is_public_user() == False"/>
        </xpath>
    </template>

    <template id="palette_list" name="PaletteLists Dropdown">
        <div t-attf-class="o_palette_list_dropdown dropdown #{_classes if hasPalettesDropdown else 'd-none'}">
            <t t-set="curr_pl" t-value="website.palette_id"/>
            <small class="d-none d-lg-inline text-muted" id="palette-data"
                   t-att-data-pl_id="curr_pl.id"
                   t-att-data-pl_width="curr_pl.width"
                   t-att-data-pl_height="curr_pl.height"
                   t-att-data-pl_depth="curr_pl.depth"
            >Palette
            </small>
            <a role="button" href="#" t-attf-class="dropdown-toggle btn btn-{{navClass}}" data-bs-toggle="dropdown">
                <t t-esc="curr_pl and curr_pl.name or ' - '"/>
            </a>
            <div class="dropdown-menu" role="menu">
                <t t-foreach="website_sale_palettes" t-as="pl">
                    <a role="menuitem" t-att-href="'/shop/change_palette/%s' % pl.id" class="dropdown-item">
                        <span class="switcher_palette" t-att-data-pl_id="pl.id" t-esc="pl.name"/>
                    </a>
                </t>
            </div>
        </div>
    </template>

    <template id="packing_list_lines" name="Packing List Lines">
        <div class="js_packing_list">
            <div t-if="packing_list and len(packing_list) > 0" class="accordion accordion-flush"
                 id="accordionExample">
                <t t-foreach="packing_list" t-as="package">
                    <div class="accordion-item">
                        <h4 class="accordion-header" id="headingOne">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                    t-attf-data-bs-target="#collapse{{package['id']}}" aria-expanded="true"
                                    t-attf-aria-controls="collapse{{package['id']}}">
                                <div class="container">
                                    <div class="row justify-content-start">
                                        <div class="col-6">
                                            <!--                                            <span>Box -</span>-->
                                            <h5>
                                                <span class="badge bg-secondary" t-out="package['name']"/>
                                            </h5>
                                        </div>
                                        <div class="col-6">
                                            <span>Packages pcs. -</span>
                                            <span class="fw-bolder badge rounded-pill bg-success package-data"
                                                  t-att-data-width="package['box'].width"
                                                  t-att-data-height="package['box'].height"
                                                  t-att-data-depth="package['box'].depth"
                                                  t-att-data-id="package['id']"
                                                  t-out="package['quantity']"/>
                                        </div>
                                    </div>
                                </div>
                            </button>
                        </h4>
                        <div t-attf-id="collapse{{package['id']}}" class="accordion-collapse collapse"
                             aria-labelledby="headingOne"
                             data-bs-parent="#accordionExample">
                            <div class="accordion-body">
                                <table t-if="package['lines'] and len(package['lines']) > 0"
                                       class="table table-striped table-sm js_packing_lines"
                                       id="packing_list">
                                    <thead>
                                        <tr>
                                            <!--                                                            <th class="td-img">Product</th>-->
                                            <th class="td-img"></th>
                                            <th></th>
                                            <th class="text-center td-qty">
                                                <!--                                                <span>Quantity</span>-->
                                            </th>
                                            <th class="text-center td-packaging">
                                                <!--                                                <span>Boxes</span>-->
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="package['lines']" t-as="line">
                                            <tr t-att-class="'optional_product info' if line.linked_line_id else None">
                                                <td t-if="not line.product_id" colspan="2"
                                                    class='td-img'/>
                                                <t t-else="">
                                                    <td align="center" class='td-img'>
                                                        <span t-if="line._is_not_sellable_line() and line.product_id.image_128">
                                                            <img t-att-src="image_data_uri(line.product_id.image_128)"
                                                                 class="img o_image_64_max rounded"
                                                                 t-att-alt="line.name_short"/>
                                                        </span>
                                                        <span t-else=""
                                                              t-field="line.product_id.image_128"
                                                              t-options="{'widget': 'image', 'qweb_img_responsive': False, 'class': 'rounded o_image_64_max'}"
                                                        />
                                                    </td>
                                                    <td class='td-product_name'>
                                                        <div>
                                                            <t t-call="website_sale.cart_line_product_link">
                                                                <strong t-field="line.name_short"/>
                                                            </t>
                                                        </div>
                                                        <t t-call="website_sale.cart_line_description_following_lines">
                                                            <t t-set="div_class"
                                                               t-value="'d-none d-md-block'"/>
                                                        </t>
                                                    </td>
                                                </t>
                                                <td class="text-center td-qty">
                                                    <div class="css_quantity input-group mx-auto justify-content-center">
                                                        <t t-if="not line._is_not_sellable_line()">

                                                            <a t-attf-href="#"
                                                               class="btn btn-link js_add_cart_json d-none d-md-inline-block"
                                                               aria-label="Remove one"
                                                               title="Remove one">
                                                                <i class="fa fa-minus"></i>
                                                            </a>
                                                            <input type="text"
                                                                   class="js_quantity form-control quantity"
                                                                   t-att-data-line-id="line.id"
                                                                   t-att-data-product-id="line.product_id.id"
                                                                   t-att-data-qty-in-cartoon="line.product_id.qty_in_cartoon"
                                                                   t-att-value="int(line.product_uom_qty) == line.product_uom_qty and int(line.product_uom_qty) or line.product_uom_qty"/>
                                                            <t t-if="line._get_shop_warning(clear=False)">
                                                                <a t-attf-href="#" class="btn btn-link">
                                                                    <i class='fa fa-warning text-warning'
                                                                       t-att-title="line._get_shop_warning()"
                                                                       role="img" aria-label="Warning"/>
                                                                </a>
                                                            </t>
                                                            <a t-else='' t-attf-href="#"
                                                               class="btn btn-link float_left js_add_cart_json d-none d-md-inline-block"
                                                               aria-label="Add one" title="Add one">
                                                                <i class="fa fa-plus"></i>
                                                            </a>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="text-muted w-100"
                                                                  t-esc="int(line.product_uom_qty)"/>
                                                            <input type="hidden"
                                                                   class="js_quantity form-control quantity"
                                                                   t-att-data-line-id="line.id"
                                                                   t-att-data-product-id="line.product_id.id"
                                                                   t-att-value="line.product_uom_qty"/>
                                                        </t>
                                                    </div>
                                                </td>
                                                <t t-set="package_qtt"
                                                   t-value="int((int(line.product_uom_qty) == line.product_uom_qty and int(line.product_uom_qty) or line.product_uom_qty)//int(line.product_id.qty_in_cartoon))"/>
                                                <td class="text-center td-packaging">
                                                    <span class="badge bg-primary" id="package_qtt"
                                                          t-out="package_qtt"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </template>

    <template id="palettes_list_lines" name="Calculated Palettes">
        <div class="card js_palettes_list mb16">
            <div class="palettes_body p-4">
                <h4 class="d-none d-xl-block">Packing Info</h4>
                <hr class="d-none d-xl-block"/>
                <div t-if="palettes_list and palettes_list['palettes'] and len(palettes_list['palettes'])&gt;0"
                     class="accordion"
                     id="accordionPalettes">
                    <t t-foreach="palettes_list['palettes']" t-as="palette">
                        <div class="accordion-item border-secondary">
                            <h4 class="accordion-header" id="headingPaletteOne">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                        t-attf-data-bs-target="#collapse{{palette['id']}}" aria-expanded="true"
                                        t-attf-aria-controls="collapse{{palette['id']}}">
                                    <div class="container">
                                        <t t-set="id" t-value="palette['id']//1000"/>
                                        <div class="row justify-content-start">
                                            <div class="col-3">
                                                <h5>
                                                    <i class="fa fa-hashtag" aria-hidden="true"></i>
                                                    <span t-attf-class="badge {{'bg-danger' if palette['fill'] &lt;50 else 'bg-warning' if palette['fill'] &lt;90 else 'bg-success'}}"
                                                          t-esc="id" aria-hidden="true"/>
                                                </h5>
                                            </div>
                                            <div class="col-6">
                                                <div class="progress" style="height: 30px;">
                                                    <div t-attf-class="progress-bar {{'bg-danger' if palette['fill'] &lt;50 else 'bg-warning' if palette['fill'] &lt;90 else 'bg-success'}}"
                                                         role="progressbar" t-attf-style="width: {{palette['fill']}}%;"
                                                         t-attf-aria-valuenow="{{palette['fill']}}"
                                                         aria-valuemin="0" aria-valuemax="100"
                                                         t-esc="palette['fill_str']"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </button>
                            </h4>
                            <div t-attf-id="collapse{{palette['id']}}" class="accordion-collapse collapse"
                                 aria-labelledby="headingPaletteOne"
                                 data-bs-parent="#accordionPalettes">
                                <div class="accordion-body">
                                    <div class="card d-flex flex-column bd-highlight mb-5">
                                        <t t-set="total_height" t-value="'Height of filled pallet: ' + str(palette['summ_width']) + ' mm'"/>
                                        <t t-set="difference" t-value="'Difference: ' + str(palette['difference']) + ' mm'"/>
                                        <t t-set="layouts_count" t-value="'Layouts: ' + str(len(palette['palette']))"/>
                                        <div class="p-2 bd-highlight text-black-50" t-esc="total_height"/>
                                        <div class="p-2 bd-highlight" t-esc="difference"/>
                                        <div class="p-2 bd-highlight" t-esc="layouts_count"/>
                                    </div>
                                    <table class="table  table-sm">
                                        <thead>
                                            <tr>
                                                <th class="text-center">
                                                    <!--                                    <span>Boxes</span>-->
                                                </th>
                                                <th class="text-center">
                                                    <span>Boxes</span>
                                                </th>
                                                <th class="text-center">

                                                </th>
                                                <th class="text-center">
                                                    <span>Max. pcs</span>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="palette['palette']" t-as="sel_layer">
                                                <tr>
                                                    <td class="text-center">
                                                        <span class="badge bg-secondary" t-esc="sel_layer['box'].name"/>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="text-muted w-100" t-esc="len(sel_layer['layers'])"/>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="text-muted w-100"
                                                              t-esc="sel_layer['max_boxes_on_layer']"/>
                                                    </td>
                                                    <td>
                                                        <div class="progress" style="height: 20px;">
                                                            <t t-set="fill_percent1"
                                                               t-value="str(sel_layer['fill']) + '%'"/>
                                                            <div t-attf-class="progress-bar {{'bg-danger' if sel_layer['fill'] &lt;50 else 'bg-warning' if sel_layer['fill'] &lt;90 else ''}}"
                                                                 role="progressbar"
                                                                 t-attf-style="width: {{sel_layer['fill']}}%;"
                                                                 t-attf-aria-valuenow="{{sel_layer['fill']}}"
                                                                 aria-valuemin="0" aria-valuemax="100"
                                                                 t-esc="fill_percent1"/>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
                <t t-if="palettes_list and palettes_list['unselected_layers'] and len(palettes_list['unselected_layers'])&gt;0">
                    <h4 class="d-none d-xl-block">Extra boxes</h4>
                    <hr class="d-none d-xl-block"/>
                    <table class="table table-striped table-sm">
                        <thead>
                            <tr>
                                <th class="text-center">
<!--                                    <span>Boxes</span>-->
                                </th>
                                <th class="text-center">
                                    <span>Boxes</span>
                                </th>
                                <th class="text-center">

                                </th>
                                <th class="text-center">
                                    <span>Max. pcs</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="palettes_list['unselected_layers']" t-as="un_layer">
                                <tr>
                                    <td class="text-center">
                                        <span class="badge bg-secondary" t-esc="un_layer['box'].name"/>
                                    </td>
                                    <td class="text-center">
                                        <span class="text-muted w-100" t-esc="len(un_layer['layers'])"/>
                                    </td>
                                    <td class="text-center">
                                        <span class="text-muted w-100" t-esc="un_layer['max_boxes_on_layer']"/>
                                    </td>
                                    <td>
                                        <div class="progress" style="height: 20px;">
                                            <t t-set="fill_percent" t-value="str(un_layer['fill']) + '%'"/>
                                            <div t-attf-class="progress-bar {{'bg-danger' if un_layer['fill'] &lt;50 else 'bg-warning' if un_layer['fill'] &lt;90 else ''}}"
                                                 role="progressbar" t-attf-style="width: {{un_layer['fill']}}%;"
                                                 t-attf-aria-valuenow="{{un_layer['fill']}}"
                                                 aria-valuemin="0" aria-valuemax="100"
                                                 t-esc="fill_percent"/>
                                        </div>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
                <t t-set="redirect_url"
                       t-value="'/web/login?redirect=/shop/confirm_order' if redirect_to_sign_in else '/shop/confirm_order'"/>
                <div class="d-flex justify-content-end mt32">
                    <div class="d-flex flex-column">
                        <a class="btn btn-secondary float-end d-none d-xl-inline-block" role="button"
                           t-attf-href="{{redirect_url}}">
                            <span>Confirm order</span>
                            <span class="fa fa-file-text"/>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="packing_list" name="Packing List">
        <t t-call="website.layout">
            <t t-set="navClass" t-valuef="light"/>
            <t t-set="website_sale_palettes" t-value="website.get_palettes_available()"/>
            <t t-set="hasPalettesDropdown" t-value="website_sale_palettes and len(website_sale_palettes)&gt;1"/>
