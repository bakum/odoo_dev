<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_sale_order_form_inherit_distrib" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.distrib</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <data>
                    <div name="button_box" position="inside">
                        <field name="can_full_access" invisible="1"/>
                        <button name="action_calculate_sale_order" type="object" class="oe_stat_button"
                                icon="fa-calculator icon">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Calculator</span>
                                <span class="o_stat_text">Preview</span>
                            </div>
                        </button>
                        <button name="action_view_incomes" type="object" class="oe_stat_button"
                                icon="fa-inbox" attrs="{'invisible': [('incoming_count', '=', 0)]}">
                            <field name="incoming_count" widget="statinfo" string="Delivery"/>
                        </button>
                    </div>
                    <xpath expr="//button[@name='action_draft']" position="attributes">
                        <attribute name="groups">ug_base_distrib.group_distrib_manager</attribute>
                    </xpath>
                    <xpath expr="//button[@name='action_cancel']" position="attributes">
                        <attribute name="groups">ug_base_distrib.group_distrib_manager</attribute>
                    </xpath>
                    <xpath expr="//button[@name='action_confirm']" position="attributes">
                        <attribute name="groups">ug_base_distrib.group_distrib_manager</attribute>
                    </xpath>
                    <xpath expr="//button[@name='action_quotation_send']" position="attributes">
                        <attribute name="groups">ug_base_distrib.group_distrib_manager</attribute>
                    </xpath>
                    <xpath expr="//button[@id='create_invoice']" position="attributes">
                        <attribute name="groups">ug_base_distrib.group_distrib_manager</attribute>
                    </xpath>
                    <xpath expr="//button[@name='action_draft']" position="before">
                        <field name="incoming_count" invisible="1"/>
                        <button name="create_distrib_move_inc" groups="ug_base_distrib.group_distrib_manager" string="Deliver"
                                type="object" class="btn btn-outline-primary"
                                attrs="{'invisible': ['|', ('state', 'not in', ['sale']), ('id', '=', False), ('incoming_count', '=', 0)]}"/>
                    </xpath>
                    <xpath expr="//tree/field[@name='product_uom_qty']" position="attributes">
                         <attribute name="attrs">{'readonly': [('parent.can_full_access', '=' ,False)]}</attribute>
                    </xpath>
                    <xpath expr="//tree/field[@name='price_unit']" position="attributes">
                        <attribute name="attrs">{'readonly': [('parent.can_full_access', '=' ,False)]}</attribute>
                    </xpath>
                    <xpath expr="//tree/field[@name='product_template_id']" position="attributes">
                        <attribute name="attrs">{'readonly': [('parent.can_full_access', '=' ,False)]}</attribute>
                    </xpath>
                    <xpath expr="//tree/field[@name='tax_id']" position="attributes">
                        <attribute name="attrs">{'readonly': [('parent.can_full_access', '=' ,False)]}</attribute>
                    </xpath>
                    <xpath expr="//tree/field[@name='discount']" position="attributes">
                        <attribute name="attrs">{'readonly': [('parent.can_full_access', '=' ,False)]}</attribute>
                    </xpath>
                    <xpath expr="//page[@name='customer_signature']" position="after">
                        <page name="package" string="Packages" groups="ug_base_distrib.group_distrib_user">
                            <group>
                                <field name="pallet_id" widget="many2one" options="{'no_create': True, 'no_open': True}"
                                       domain="[('type_of', '=', 'pallet')]" readonly="1"/>
                            </group>
                            <field name="package_line"
                                   attrs="{'readonly': 1}">
                                <tree create="false" editable="top">
                                    <field name="name" optional="hide"/>
                                    <field name="cartoon_id" optional="show"/>
                                    <field name="package_qty"/>
                                    <field name="weight_netto"/>
                                    <field name="weight_brutto"/>
                                </tree>
                            </field>
                            <group name="note_group" col="6" class="mt-2 mt-md-0">
                                <group class="oe_subtotal_footer oe_right" colspan="2" name="sale_total">
                                    <field name="boxes_total" readonly="1"/>
                                    <field name="netto_total" readonly="1"/>
                                    <field name="brutto_total" readonly="1"/>
                                </group>
                                <div class="clearfix"/>
                            </group>
                        </page>
                    </xpath>
                    <xpath expr="//field[@name='team_id']" position="after">
                        <field name="place_warehouse_id" domain="[('places_type', '=', 'warehouse')]"/>
                        <field name="place_taking_googs_id" domain="[('places_type', '=', 'point_of_load')]"/>
                    </xpath>
                </data>
            </field>
        </record>

        <record model="ir.actions.server" id="action_confirmation_undo">
            <field name="name">Cancel Confirmation Flag</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="groups_id" eval="[(4, ref('ug_base_distrib.group_distrib_manager'))]"/>
            <field name="state">code</field>
            <field name="code">
                action = records.action_confirmation_undo()
            </field>
        </record>

        <record model="ir.actions.server" id="action_confirmation_set">
            <field name="name">Set Confirmation Flag</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="groups_id" eval="[(4, ref('ug_base_distrib.group_distrib_manager'))]"/>
            <field name="state">code</field>
            <field name="code">
                action = records.action_confirmation_set()
            </field>
        </record>
    </data>
</odoo>