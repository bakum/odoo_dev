<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_wholesale_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.distrib</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="90"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='sale_prohibited_data']" position="after">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Send confirmation email</span>
                            <div class="text-muted content-group mt16">
                                <field name="send_confirmation"/>
                            </div>
                            <div class="text-muted">
                                <span class="o_form_label">Send email after order confirmation.</span>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>