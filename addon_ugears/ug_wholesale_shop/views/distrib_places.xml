<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_distributors_places_form" model="ir.ui.view">
        <field name="name">distrib.places.form</field>
        <field name="model">distrib.places</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
<!--                    <field name="ref" readonly="1"/>-->
                    <div class="oe_title mb24">
                        <field name="active" invisible="1"/>
                        <field name="name" force_save="1"/>
                    </div>
                    <group>
                        <group id="header_right_group">
                            <field name="places_type" force_save="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_distributors_places_tree" model="ir.ui.view">
        <field name="name">distrib.places.tree</field>
        <field name="model">distrib.places</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="places_type"/>
            </tree>
        </field>
    </record>

    <record id="view_distributors_places_search" model="ir.ui.view">
        <field name="name">distrib.places.search</field>
        <field name="model">distrib.places</field>
        <field name="arch" type="xml">
            <search>
                <filter name="filter_archived" string="Archived" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="action_distrib_places" model="ir.actions.act_window">
        <field name="name">Geographic Places</field>
        <field name="res_model">distrib.places</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
            id="menu_distrib_places"
            name="Geographic Places"
            parent="ug_base_distrib.menu_distrib_settings"
            action="action_distrib_places"
            groups="ug_base_distrib.group_distrib_manager"
            sequence="14"/>

</odoo>