<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_form_inherit_distributors" model="ir.ui.view">
            <field name="name">distributors.form.inherit.distrib</field>
            <field name="model">distrib.distributors</field>
            <field name="inherit_id" ref="ug_base_distrib.view_distributors_distrib_form"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//page[@name='distrib_additional']/group" position="inside">
                        <group>
                            <field name="pallet_id" options="{'no_open': True, 'no_quick_create': True}"
                                   domain="[('type_of', '=', 'pallet')]"/>
                        </group>
                    </xpath>
                    <xpath expr="//field[@name='region_id']" position="after">
                        <field name="discount_available" groups="ug_base_distrib.group_distrib_manager"/>
                    </xpath>
                    <xpath expr="//page[@name='distrib_additional']" position="after">
                        <page name="discount" string="Discount Configuration" groups="ug_base_distrib.group_distrib_manager"
                            attrs="{'invisible': [('discount_available', '=', False)]}">
                            <group>
                                <field name="discount_after" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </group>
                            <group>
                                <field name="discount_value"/>
                            </group>
                        </page>
                    </xpath>
                </data>
            </field>
        </record>
    </data>
</odoo>