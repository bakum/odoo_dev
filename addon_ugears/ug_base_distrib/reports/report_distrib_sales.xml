<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="distrib_report_sales_view_pivot" model="ir.ui.view">
        <field name="name">distrib_report_sales_view.pivot</field>
        <field name="model">report.distrib.sales</field>
        <field name="arch" type="xml">
            <pivot string="Distributor sales" sample="0" disable_linking="1">
<!--                <field name="currency_id" type="col"/>-->
                <field name="date" type="col" interval="month"/>
                <field name="channel_id" type="col"/>
<!--                <field name="beginning_stock" type="measure"/>-->
<!--                <field name="sell_in" type="measure"/>-->
                <field name="balance" type="measure" string="pcs"/>
                <field name="distrib_id" type="row"/>
                <field name="product_category_id" type="row"/>
                <field name="product_id" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="distrib_report_sales_view_tree" model="ir.ui.view">
        <field name="name">distrib_report_sales_view.tree</field>
        <field name="model">report.distrib.sales</field>
        <field name="arch" type="xml">
            <tree string="Distributor sales" sample="0">
                <field name="date" interval="month"/>
                <field name="distrib_id"/>
                <field name="channel_id"/>
                <field name="product_id"/>
                <field name="balance"/>
            </tree>
        </field>
    </record>

    <record id="distrib_report_sales_view_search" model="ir.ui.view">
        <field name="name">distrib_sales_view.search</field>
        <field name="model">report.distrib.sales</field>
        <field name="arch" type="xml">
            <search string="Search">
                <field name="product_id"
                       filter_domain="['|',('product_id.barcode', 'ilike', self),('product_id.default_code', 'ilike', self)]"/>
                <field name="distrib_id"/>
                <filter string="Current Month" name="month"
                        domain="[('date','=', (context_today()).strftime('%Y-%m-01'))]"/>
                <filter string="Previous Month" name="last_month"
                        domain="[('date','=', (context_today() - datetime.timedelta(days=context_today().day + 1)).strftime('%Y-%m-01'))]"/>
                <filter string="Current Year" name="year"
                        domain="[('date','&gt;=', (context_today()).strftime('%Y-01-01')),
                        ('date','&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Previous Year" name="last_year"
                        domain="[('date','&gt;=', (context_today()- datetime.timedelta(days=365)).strftime('%Y-01-01')),
                        ('date','&lt;', context_today().strftime('%Y-01-01'))]"/>
<!--                <group expand="0" string="Group By">-->
<!--                    <filter string="Distributor" name="distrib" domain="[]" context="{'group_by':'distrib_id'}"/>-->
<!--                </group>-->
            </search>
        </field>
    </record>

    <record id="action_distrib_sales_report" model="ir.actions.act_window">
        <field name="name">Distributor Sales Report</field>
        <field name="res_model">report.distrib.sales</field>
        <field name="search_view_id" ref="distrib_report_sales_view_search"/>
<!--        <field name="domain">[('state', '=', 'forecast')]</field>-->
        <field name="context">{'search_default_month': 1}</field>
<!--        <field name="context">{'search_default_month': 1, 'group_by': ['distrib_id','currency_id']}</field>-->
        <field name="view_mode">pivot,tree</field>
    </record>

    <menuitem
            id="menu_distrib_sales_report"
            name="Distributor Sales Report"
            parent="menu_distrib_sales_parent_report"
            action="action_distrib_sales_report"
            groups="ug_base_distrib.group_distrib_manager,ug_base_distrib.group_distrib_user"
            sequence="16"/>
</odoo>