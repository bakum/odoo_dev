<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="distrib_report_expenses_view_pivot" model="ir.ui.view">
        <field name="name">distrib_report_expenses_view.pivot</field>
        <field name="model">report.distrib.expenses</field>
        <field name="arch" type="xml">
            <pivot string="Distributor expenses" sample="0">
                <field name="distrib_id" type="col"/>
                <field name="date" type="col" interval="year"/>
                <field name="expense_id" type="row"/>
                <field name="expense_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="distrib_report_expenses_view_search" model="ir.ui.view">
        <field name="name">distrib_report_qtt_view.search</field>
        <field name="model">report.distrib.quantity</field>
        <field name="arch" type="xml">
            <search string="Search">
                <field name="distrib_id"/>
                <filter string="Last Week" name="week"
                        domain="[('date','&gt;', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d')),
                        ('date','&lt;=', datetime.datetime.now().strftime('%Y-%m-%d'))]"/>
                <filter string="Last Month" name="month"
                        domain="[('date','&gt;', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d')),
                        ('date','&lt;=', datetime.datetime.now().strftime('%Y-%m-%d'))]"/>
                <filter string="Last Year" name="year"
                        domain="[('date','&gt;', (context_today() - datetime.timedelta(days=365)).strftime('%Y-%m-%d')),
                        ('date','&lt;=', datetime.datetime.now().strftime('%Y-%m-%d'))]"/>
<!--                <searchpanel>-->
<!--                        <field name="distrib_id" icon="fa-building" enable_counters="1"/>-->
<!--                </searchpanel>-->
            </search>
        </field>
    </record>

    <record id="action_distrib_expenses_report" model="ir.actions.act_window">
        <field name="name">Distributor Expenses Report</field>
        <field name="res_model">report.distrib.expenses</field>
        <field name="search_view_id" ref="distrib_report_expenses_view_search"/>
<!--        <field name="domain">[('state', '=', 'forecast')]</field>-->
        <field name="context">{'search_default_month': 1}</field>
        <field name="view_mode">pivot</field>
    </record>

    <menuitem
            id="menu_distrib_expenses_report"
            name="Distributor Expenses Report"
            parent="menu_distrib_report"
            action="action_distrib_expenses_report"
            groups="ug_base_distrib.group_distrib_manager,ug_base_distrib.group_distrib_user"
            sequence="15"/>
</odoo>