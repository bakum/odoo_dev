<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Used in Forecasted Report -->
    <record id="distrib_report_qtt_view_graph" model="ir.ui.view">
        <field name="name">distrib_report_qtt_view_graph</field>
        <field name="model">report.distrib.quantity</field>
        <field name="arch" type="xml">
            <graph string="distrib_report_qtt_view_graph" type="pie" sample="1" disable_linking="1">
                <field name="date" interval="day"/>
                <field name="categ_id"/>
<!--                <field name="product_id"/>-->
                <field name="product_qty" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="distrib_report_qtt_view_pivot" model="ir.ui.view">
        <field name="name">distrib_report_qtt_view.pivot</field>
        <field name="model">report.distrib.quantity</field>
        <field name="arch" type="xml">
            <pivot string="Distributor quantity" sample="1">
                <field name="date" type="col" interval="day"/>
                <field name="distrib_id" type="row"/>
                <field name="categ_id" type="row"/>
                <field name="product_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="distrib_report_qtt_view_search" model="ir.ui.view">
        <field name="name">distrib_report_qtt_view.search</field>
        <field name="model">report.distrib.quantity</field>
        <field name="arch" type="xml">
            <search string="Search">
                <field name="distrib_id"/>
                <filter string="Today" name="today"
                        domain="[('date','&gt;=', datetime.datetime.now().strftime('%Y-%m-%d')),
                        ('date','&lt;=', datetime.datetime.now().strftime('%Y-%m-%d'))]"/>
                <filter string="Last 7 days" name="week"
                        domain="[('date','&gt;', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d')),
                        ('date','&lt;=', datetime.datetime.now().strftime('%Y-%m-%d'))]"/>
                <filter string="Last 30 days" name="month"
                        domain="[('date','&gt;', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d')),
                        ('date','&lt;=', datetime.datetime.now().strftime('%Y-%m-%d'))]"/>
<!--                <filter string="Last Year" name="year"-->
<!--                        domain="[('date','&gt;', (context_today() - datetime.timedelta(days=365)).strftime('%Y-%m-%d')),-->
<!--                        ('date','&lt;=', datetime.datetime.now().strftime('%Y-%m-%d'))]"/>-->
                <group expand="0" string="Group By">
                    <filter string="Date" name="date" domain="[]" context="{'group_by':'date'}"/>
                    <filter string="Distributor" name="distrib_id" domain="[]" context="{'group_by':'distrib_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_distrib_quantity_report" model="ir.actions.act_window">
        <field name="name">Distributor Quantity Report</field>
        <field name="res_model">report.distrib.quantity</field>
        <field name="search_view_id" ref="distrib_report_qtt_view_search"/>
        <field name="domain">[('state', '=', 'forecast')]</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="view_mode">pivot,graph</field>
    </record>

    <menuitem
            id="menu_distrib_quantity_report"
            name="Distributor Quantity Report"
            parent="menu_distrib_report"
            action="action_distrib_quantity_report"
            groups="ug_base_distrib.group_distrib_manager,ug_base_distrib.group_distrib_user"
            sequence="14"/>
</odoo>