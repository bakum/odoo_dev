<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="region.OwlRegionRel" owl="1">
        <div class="vh-100 overflow-auto bg-muted">
            <div class="row m-3">
                <div class="col-lg-12">
                    <div class="row">
                        <div class="col m-0 p-0">
                            <div class="shadow-sm border m-2 p-4 bg-white">
                                <div class="d-flex align-items-center justify-content-between">
                                    <h1 class="text-primary fw-bold">Import Regions Relations</h1>
                                    <button type="button" t-on-click="onDownload" class="btn btn-lg btn-outline-primary">
                                        <i class="fa fa-download"/>
                                        Download Regions Relations Template
                                    </button>
                                    <t t-if="state.recalc_not_pressed">
                                        <button type="button" t-on-click="onRecalculate" class="btn btn-lg btn-outline-primary">
                                            Run Recalculations Totals
                                        </button>
                                        <button type="button" t-on-click="onRecalculateOnceByMonth" class="btn btn-lg btn-outline-primary">
                                            Run Recalculations Totals (Once by Month)
                                        </button>
                                    </t>
                                    <t t-else="">
                                        <button type="button" t-on-click="onRecalculate" class="btn btn-lg btn-outline-primary" disabled="">
                                            Run Recalculations Totals
                                        </button>
                                        <button type="button" t-on-click="onRecalculateOnceByMonth" class="btn btn-lg btn-outline-primary" disabled="">
                                            Run Recalculations Totals (Once by Month)
                                        </button>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-6 m-0 p-0">
                            <RecordsRenderer total_by_days="state.total_by_days" total_by_month="state.total_by_month" diff_moments="state.diff_moments"/>
                            <div class="shadow-sm border m-2 p-4 bg-white text-center">
                                <!--                                <div class="h1 fw-bold text-dark" style="font-size: 48px"><span t-esc="props.value"/></div>-->
                                <!--                                <div class="h3 text-muted"><span t-esc="props.name"/></div>-->
                                <div class="h3 mt-5">
                                    <div class="h1 mb-3">File Uploader</div>
                                    <div class="mb-3">
                                        <label class="form-label-me-2">Upload file</label>
                                    </div>
                                    <div class="mb-3">
                                        <input class="form-control" type="file"
                                               accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                                               t-ref="file"/>
                                    </div>
                                    <!--                                    <input class="form-control" t-model="state.serverId"/>-->
                                    <t t-if="state.serverId > 0">
                                        <div class="mb-3">
                                            <button type="button" t-on-click="onImport"
                                                    class="btn btn-lg btn-primary">Import</button>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="mb-3">
                                            <button type="button" t-on-click="onImport"
                                                    class="btn btn-lg btn-primary disabled">Import</button>
                                        </div>
                                    </t>
                                </div>
                            </div>
                            <div class="o_content mb-10">
                                <div class="o_view_nocontent">
                                    <div class="o_nocontent_help">
                                        <p class="o_view_nocontent_smiling_face">
                                Upload an Excel file to import
                            </p>
                                        <p>
                                Excel files are recommended as formatting is automatic.
                            </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6 m-0 p-0">
                            <t t-if="!state.exportStopped">
                            <ProgressRenderer progress_days="state.progress_days" progress_month="state.progress_month"/>
                            </t>
                            <t t-if="!state.logIsEmpty">
                                <t t-if="'Partner' in state.log">
                                    <LogRenderer identity="'Partners'" name="'Partners Log'" log="state.log.Partner"/>
                                </t>
                                <t t-if="'Product' in state.log">
                                    <LogRenderer identity="'Products'" name="'Products Log'" log="state.log.Product"/>
                                </t>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>