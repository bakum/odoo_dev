<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="change_pricelist_view" model="ir.ui.view">
            <field name="name">Change Pricelist</field>
            <field name="model">distrib.change.pricelist</field>
            <field name="arch" type="xml">
                <form string="Change Pricelist">
                    <header>
                    </header>
                    <sheet>
                        <group>
                            <field name="distrib_id" readonly="1" options="{'no_open': True, 'no_quick_create': True}"/>
                            <field name="pricelist_id" options="{'no_open': True, 'no_quick_create': True}"
                                   domain="[('currency_id', '=', currency_id)]"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Save" name="save_pricelist" class="oe_highlight" type="object"/>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_change_pricelist" model="ir.actions.act_window">
            <field name="name">Change Pricelist</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">distrib.change.pricelist</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="change_pricelist_view"/>
            <field name="target">new</field>
        </record>
    </data>
</odoo>