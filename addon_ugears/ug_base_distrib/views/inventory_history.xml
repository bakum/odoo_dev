<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_distrib_quantity_history" model="ir.ui.view">
        <field name="name">Inventory Report at Date</field>
        <field name="model">distrib.quantity.history</field>
        <field name="arch" type="xml">
            <form string="Choose your date">
                <group>
                    <group>
                        <field name="inventory_datetime"/>
                    </group>
                    <group>
                        <field name="distrib_id" groups="ug_base_distrib.group_distrib_manager"/>
                    </group>
                </group>
                <footer>
                    <button name="open_at_date" string="Confirm" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z" />
                </footer>
            </form>
        </field>
    </record>
</odoo>