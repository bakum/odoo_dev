<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_product_public_form_inherit" model="ir.ui.view">
            <field name="name">product.public.form.inherit.distrib.fields</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <data>
                    <div name="button_box" position="inside">
                        <t groups="ug_base_distrib.group_distrib_user">
                            <button type="object" class="oe_stat_button" icon="fa-shopping-basket"
                                    name="action_open_distrib_quants"
                                    attrs="{'invisible': [('type', 'in', ('service'))]}">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value" widget="statinfo">
                                        <field name="qty_available_dist" widget="statinfo" nolabel="1" class="mr4"/>
                                        <field name="uom_name"/>
                                    </span>
                                    <span class="o_stat_text">Distributors</span>
                                </div>
                            </button>
                        </t>
                    </div>
                    <xpath expr="//field[@name='uom_po_id']" position="after">
                        <field name="guid" readonly="1"/>
                        <field name="theme_id" options="{'no_open': True, 'no_quick_create': True}"/>
                        <field name="region_ids" widget="many2many_tags"
                               groups="ug_base_distrib.group_distrib_manager"/>
                    </xpath>
                    <xpath expr="//field[@name='list_price']" position="attributes">
                        <attribute name="groups">ug_base_distrib.group_distrib_technical</attribute>
                    </xpath>
                    <xpath expr="//field[@name='standard_price']" position="attributes">
                        <attribute name="groups">ug_base_distrib.group_distrib_technical</attribute>
                    </xpath>
                </data>
            </field>
        </record>

        <record id="view_product_public_kanban_inherit" model="ir.ui.view">
            <field name="name">product.public.kanban.inherit.distrib.fields</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_kanban_view"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='product_lst_price']" position="attributes">
                    <attribute name="groups">ug_base_distrib.group_distrib_technical</attribute>
                </xpath>
                <xpath expr="//div[@name='product_lst_price']" position="after">
                    <div name="product_barcode" class="mt-1">
                        <field name="barcode"/>
                    </div>
                </xpath>
            </field>
        </record>

        <record id="view_product_public_tree_inherit" model="ir.ui.view">
            <field name="name">product.public.tree.inherit.distrib.fields</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='standard_price']" position="after">
                        <field name="guid" readonly="1" optional="hide"/>
                        <field name="qty_available_dist" readonly="1" optional="hide"/>
                    </xpath>
                    <xpath expr="//field[@name='barcode']" position="replace">
                        <field name="barcode" optional="show" attrs="{'readonly': [('product_variant_count', '&gt;', 1)]}"/>
                    </xpath>
                </data>
            </field>
        </record>

        <record id="view_distrib_product_tree" model="ir.ui.view">
            <field name="name">product.distrib.tree.inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_product_tree_view"/>
            <field name="arch" type="xml">
                <field name="type" position="after">
                    <field name="qty_available_dist" attrs="{'invisible':[('type', '!=', 'consu')]}" optional="show"
                           decoration-danger="qty_available_dist &lt; 0" decoration-warning="qty_available_dist == 0" decoration-success="qty_available_dist &gt; 0" decoration-bf="1" groups="ug_base_distrib.group_distrib_user"/>
                    <!--                    <field name="virtual_available_dist" attrs="{'invisible':[('type', '!=', 'consu')]}" string="Forecasted Quantity" optional="show" groups="ug_base_distrib.group_distrib_user"/>-->
                </field>
            </field>
        </record>

        <record id="view_distrib_product_search" model="ir.ui.view">
            <field name="name">product.distrib.search.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_search_view"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='consumable']" position="after">
                    <separator/>
                    <filter string="On Hand" name="on_hand" domain="[('qty_available_dist', '&gt;', 0)]"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
