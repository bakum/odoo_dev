<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_distributors_distrib_form" model="ir.ui.view">
        <field name="name">distrib.distributors.form</field>
        <field name="model">distrib.distributors</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <header>
                        <button name="action_fill_currency_for_all"
                            type="object"
                            string="Fill Currency from Pricelist"
                            class="btn-primary"
                            attrs="{'invisible': [('currency_id', '!=', False)]}"
                            groups="ug_base_distrib.group_distrib_manager"/>
                        <button name="%(action_change_pricelist)d" class="btn-primary" data-hotkey="v" string="Change Pricelist" type="action"
                                context="{
                                'default_distrib_id': id,
                                'default_currency_id': currency_id,
                                'default_pricelist_id': pricelist_id
                                }"
                                attrs="{'invisible': ['|',('has_move', '=', False), ('id', '=', False)]}"
                                groups="ug_base_distrib.group_distrib_manager"
                                confirm="Are you sure you want to do this?"/>
                    </header>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <field name="ref" readonly="1"/>
                    <div class="oe_title mb24">
                        <field name="active" invisible="1"/>

                        <h1>
                            <field id="company" class="text-break" name="name" default_focus="1" placeholder="e.g. Lumber Inc"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <span class="o_form_label o_td_label" name="address_name">
                                <b>Address</b>
                            </span>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}" context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <div name="partner_address_country" class="d-flex justify-content-between">
                                    <field name="country_id" placeholder="Country" class="o_address_country" options="{'no_open': True, 'no_create': True}"/>
                                </div>
                            </div>
                        </group>
                        <group>
                            <field name="partner_id" widget="res_partner_many2one"
                                   placeholder="Company Name..." domain="[('is_company', '=', True)]" options="{'no_open': True, 'no_quick_create': True}"/>
                            <field name="phone" widget="phone"/>
                            <field name="mobile" widget="phone"/>
                            <field name="email" widget="email" context="{'gravatar_image': True}"/>
                            <field name="website" string="Website" widget="url" placeholder="e.g. https://www.odoo.com"/>
                            <field name="region_id" required="1" options="{'no_open': True, 'no_create': True}" groups="ug_base_distrib.group_distrib_manager"/>
                        </group>
                    </group>
                    <notebook colspan="4">
                        <page name="distrib_additional" string="Informations">
                            <group>
                                <group>
                                    <field name="has_move" invisible="1"/>
                                    <field name="pricelist_id" options="{'no_open': True, 'no_quick_create': True}" attrs="{'readonly': [('has_move', '!=', False)]}"/>
                                    <field name="currency_id" options="{'no_open': True, 'no_quick_create': True}" attrs="{'readonly': [('has_move', '!=', False)]}"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_distributors_distrib_tree" model="ir.ui.view">
        <field name="name">distrib.distributors.tree</field>
        <field name="model">distrib.distributors</field>
        <field name="arch" type="xml">
            <tree>
                <field name="ref"/>
                <field name="name"/>
                <field name="country_id"/>
            </tree>
        </field>
    </record>

    <record id="view_distributors_distrib_search" model="ir.ui.view">
        <field name="name">distrib.distributors.search</field>
        <field name="model">distrib.distributors</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('ref', 'ilike', self)]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="action_distrib_options_form" model="ir.actions.act_window">
        <field name="name">Distributors</field>
        <field name="res_model">distrib.distributors</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_distrib_settings_distrib" name="Distributors" parent="menu_distrib_settings" sequence="2"/>
    <menuitem
            id="menu_distrib_distrib"
            name="Distributors"
            parent="menu_distrib_settings_distrib"
            action="action_distrib_options_form"
            groups="ug_base_distrib.group_distrib_manager,ug_base_distrib.group_distrib_user"
            sequence="12"/>
    <menuitem
            id="menu_distrib_partner"
            name="Partners"
            parent="menu_distrib_settings_distrib"
            action="partner_template_action_distrib"
            groups="ug_base_distrib.group_distrib_manager"
            sequence="12"/>        
</odoo>
