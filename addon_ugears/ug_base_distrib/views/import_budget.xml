<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ug_import_distrib_budget_from_xls_view" model="ir.ui.view">
            <field name="name">Import budget</field>
            <field name="model">ug.distrib.import.budget</field>
            <field name="arch" type="xml">
                <form string="Import budget">
                    <sheet>
                        <div class="oe_title pb-4">
                            <H3>
                                <field name="name" readonly="1"/>
                            </H3>
                        </div>
                        <field name="len_products" invisible="1"/>
                        <group>
                            <group>
                                <field name="xls_filename" invisible="1"/>
                                <field name="xls_file" filename="xls_filename"/>
                            </group>
                            <group>
                                 <field name="date"/>
                                <field name="distrib_id" widget="many2one" options="{'no_create': True, 'no_open': True}"/>
                            </group>
                        </group>
                        <div class="o_statusbar_buttons d-flex align-items-center align-content-around flex-wrap">
                            <button string="Load budget from Excel" name="load_budget_from_xls" class="oe_highlight" type="object"
                                attrs="{'invisible': [('xls_filename', '=', False)]}"/>
                        </div>
                        <notebook attrs="{'invisible': [('len_products', '=', 0)]}">
                            <page string="Products">
                                <field name="products_ids">
                                    <tree create="false" editable="top">
                                        <field name="product_id" widget="many2one" options="{'no_create': True, 'no_open': True}" attrs="{'readonly': [('product_id', '!=', False)]}"/>
                                        <field name="name" readonly="1" optional="hide"/>
                                        <field name="product_uom_qty"/>
                                        <field name="product_uom_qty2"/>
                                        <field name="product_uom_qty3"/>
                                        <field name="product_uom_qty4"/>
                                        <field name="product_uom_qty5"/>
                                        <field name="product_uom_qty6"/>
                                        <field name="product_uom_qty7"/>
                                        <field name="product_uom_qty8"/>
                                        <field name="product_uom_qty9"/>
                                        <field name="product_uom_qty10"/>
                                        <field name="product_uom_qty11"/>
                                        <field name="product_uom_qty12"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <footer>
                        <button string="Save budget" name="save_budget" class="oe_highlight" type="object"
                                attrs="{'invisible': [('len_products', '=', 0)]}"/>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_import_distrib_budget" model="ir.actions.act_window">
            <field name="name">Import distributor budget</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ug.distrib.import.budget</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="ug_import_distrib_budget_from_xls_view"/>
            <field name="target">new</field>
        </record>

        <record id="view_ug_import_distrib_budget_tree" model="ir.ui.view">
            <field name="name">ug.import.distrib.budget.tree.inherit</field>
            <field name="model">distrib.budget.move</field>
            <field name="inherit_id" ref="ug_base_distrib.view_distrib_budgets_tree"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//tree" position="attributes">
                        <attribute name="js_class">import_distrib_budget_list</attribute>
                    </xpath>
                </data>
            </field>
        </record>
    </data>
</odoo>