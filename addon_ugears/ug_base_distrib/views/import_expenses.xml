<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
         <record id="ug_import_distrib_expenses_from_xls_view" model="ir.ui.view">
            <field name="name">Import expenses</field>
            <field name="model">ug.distrib.import.expenses</field>
            <field name="arch" type="xml">
                <form string="Import expenses">
                    <sheet>
                        <div class="oe_title pb-4">
                            <H3>
                                <field name="name" readonly="1"/>
                            </H3>
                        </div>
                         <field name="len_expenses" invisible="1"/>
                        <group>
                            <group>
                                <field name="xls_filename" invisible="1"/>
                                <field name="xls_file" filename="xls_filename"/>
                                <field name="currency_id"/>
                            </group>
                            <group>
                                 <field name="date"/>
                                <field name="distrib_id" widget="many2one" options="{'no_create': True, 'no_open': True}"/>
                            </group>
                        </group>
                        <div class="o_statusbar_buttons d-flex align-items-center align-content-around flex-wrap">
                            <button string="Load costs from Excel" name="load_costs_from_xls" class="oe_highlight" type="object"
                                attrs="{'invisible': [('xls_filename', '=', False)]}"/>
                        </div>
                        <notebook attrs="{'invisible': [('len_expenses', '=', 0)]}">
                            <page string="Expenses">
                                <field name="expenses_ids">
                                    <tree create="false" editable="top">
                                        <field name="expense_id" widget="many2one" options="{'no_create': True, 'no_open': True}" attrs="{'readonly': [('expense_id', '!=', False)]}"/>
                                        <field name="descr" readonly="1" optional="hide"/>
                                        <field name="currency_id" invisible="1"/>
                                        <field name="expense_total"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <footer>
                        <button string="Save costs" name="save_expenses" class="oe_highlight" type="object"
                                attrs="{'invisible': [('len_expenses', '=', 0)]}"/>
                    </footer>
                </form>
            </field>
         </record>

        <record id="action_import_distrib_expenses" model="ir.actions.act_window">
            <field name="name">Import distributor expenses</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ug.distrib.import.expenses</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="ug_import_distrib_expenses_from_xls_view"/>
            <field name="target">new</field>
        </record>

        <record id="view_ug_import_distrib_expenses_tree" model="ir.ui.view">
            <field name="name">ug.import.distrib.expenses.tree.inherit</field>
            <field name="model">distrib.marketing.expenses</field>
            <field name="inherit_id" ref="ug_base_distrib.view_distrib_expenses_tree"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//tree" position="attributes">
                        <attribute name="js_class">import_distrib_expenses_list</attribute>
                    </xpath>
                </data>
            </field>
        </record>

    </data>
</odoo>