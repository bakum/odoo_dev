<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_distributors_distrib_move_line_form" model="ir.ui.view">
        <field name="name">distrib.distributors.move.line.form</field>
        <field name="model">distrib.distributors.move.line</field>
        <field name="arch" type="xml">
            <form edit="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" widget="section_and_note_text" optional="show" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group id="header_left_group">
                            <field name="operation"/>
                            <field name="product_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="product_uom_qty"/>
                        </group>
                        <group id="header_right_group">
                            <field name="distrib_id"/>
                            <field name="state" widget="badge" decoration-success="state == 'done'"
                                decoration-warning="state == 'draft'"/>
                            <field name="move_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>