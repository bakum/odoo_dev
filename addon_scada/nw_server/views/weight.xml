<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_scada_weight_tree" model="ir.ui.view">
        <field name="name">nw.weight.list</field>
        <field name="model">nw.weight</field>
        <field name="arch" type="xml">
            <list default_order='write_date desc'>
                <field name="moxa_id"/>
                <field name="write_date"/>
                <field name="nid"/>
                <field name="value1"/>
                <field name="value2"/>
                <field name="value3"/>
                <field name="value4"/>
                <field name="value5" optional="hide"/>
                <field name="is_stable"/>
                <field name="cross_platform_shift" optional="hide"/>
                <field name="cross_rail_shift" optional="hide"/>
                <field name="crc" optional="hide"/>
                <field name="answer_crc" optional="hide"/>
                <field name="count"/>
                <field name="error"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_scada_weight_search" model="ir.ui.view">
        <field name="name">nw.weight.search</field>
        <field name="model">nw.weight</field>
        <field name="arch" type="xml">
            <search>
                <field name="moxa_id"/>
                <group expand="0" string="Group By">
                    <filter string="Moxa" name="moxa_id" context="{'group_by': 'moxa_id'}"/>
                </group>
                <group expand="0" string="Group By">
                    <filter string="Thread" name="nid" context="{'group_by': 'nid'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_scada_weight_form" model="ir.actions.act_window">
        <field name="name">Weight values</field>
        <field name="res_model">nw.weight</field>
        <field name="path">weight</field>
        <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.server" id="action_get_monitor_is_running">
        <field name="name">Get Monitor IS Running</field>
        <field name="model_id" ref="nw_server.model_nw_moxa"/>
        <field name="state">code</field>
        <field name="code">
            model.get_monitor_is_running()
        </field>
    </record>

    <menuitem
            id="menu_scada_weight"
            name="Weight values"
            parent="menu_scada_protokol"
            action="nw_server.action_scada_weight_form"
            groups="nw_server.group_scada_user,nw_server.group_scada_manager"
            sequence="3"/>
</odoo>
