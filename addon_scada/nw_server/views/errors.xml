<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_scada_errors_tree" model="ir.ui.view">
        <field name="name">nw.errors.list</field>
        <field name="model">nw.error</field>
        <field name="arch" type="xml">
            <list default_order='write_date desc'>
                <field name="moxa_id"/>
                <field name="write_date"/>
                <field name="nid"/>
                <field name="count"/>
                <field name="value"/>
                <field name="error"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_scada_errors_search" model="ir.ui.view">
        <field name="name">nw.error.search</field>
        <field name="model">nw.error</field>
        <field name="arch" type="xml">
            <search>
                <field name="moxa_id"/>
                <group expand="0" string="Group By">
                    <filter string="Moxa" name="moxa_id" context="{'group_by': 'moxa_id'}"/>
                </group>
                <group expand="0" string="Group By">
                    <filter string="Thread" name="nid" context="{'group_by': 'nid'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_scada_errors_form" model="ir.actions.act_window">
        <field name="name">Errors</field>
        <field name="res_model">nw.error</field>
        <field name="path">error</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
            id="menu_scada_errors"
            name="Errors"
            parent="menu_scada_protokol"
            action="nw_server.action_scada_errors_form"
            groups="nw_server.group_scada_user,nw_server.group_scada_manager"
            sequence="4"/>
</odoo>
