<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="llm_chat.ChatInterface" owl="1">
    <div class="d-flex justify-content-center align-items-center bg-body-tertiary"
         style="height: 100vh; width: 100vw;">

      <div class="d-flex flex-column bg-white rounded w-100"
           style="max-width: 900px; height: 75vh;">

        <!-- Messages -->
        <div t-ref="chatMessages"
             class="flex-grow-1 overflow-auto p-4 d-flex flex-column"
             style="min-height: 0;">
          <div t-foreach="state.messages" t-as="msg" t-key="msg.id"
                 t-att-class="'chat-message ' + (msg.sender === 'user' ? 'message-user align-self-end' : 'message-assistant align-self-start')">
            <t t-if="!msg.text">
              <img src="/rag_search/static/src/img/dots.svg"
                 alt="loading..."
                 style="width: 60px; height: 15px;" />
            </t>
            <t t-else="">
              <t t-out="msg.text" />
<!--            <ChatMessage msg="msg"/>-->
            </t>
            </div>
        </div>

        <!-- Input -->
        <div class="border-top p-3 bg-white">
          <form t-on-submit.prevent="sendMessage" class="d-flex gap-2 align-items-end">
            <textarea t-ref="textarea"
                      t-model="state.input"
                      class="form-control"
                      placeholder="Type your message..."
                      rows="1"
                      style="resize: none; overflow: hidden;"
                      t-on-input="autoResize"/>
            <button type="submit" class="btn btn-primary">
              <i class="fa fa-paper-plane me-1"/></button>
          </form>
        </div>

      </div>
    </div>
  </t>
</templates>
