<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="sign_auth.CertLoginApp" owl="1">   
        <form class="oe_custom_form" role="form" t-on-submit="onSubmit">
            <h6 class="fw-normal text-muted text-center" style="font-size: 0.8rem;">Оберіть зі списку свого надавача електронних довірчих послуг – суб’єкта,
            до якого ви зверталися для отримання електронного підпису.<br/>
            (зазвичай *.dat або *.pfx, *.pk8, *.zs2, *.jks)</h6>
            <select name="cert_provider" t-ref="CAsServersSelect" class="form-select mt-2" t-on-change="onchangeCASettings"> </select>
            <output t-ref="SelectedCertsList" hidden="1"> </output>
            <br/>
            <output t-ref="SelectedCRLsList" hidden="1"> </output>
            <div class="input-group mb-3">
                <input type="text" class="form-control" id="PKeyFileName" t-ref="PKeyFileName"
                        placeholder="Особистий ключ" 
                        aria-label="Особистий ключ" readonly="1"
                        onclick="document.getElementById('PKeyFileInput').click();"/>
                <span class="input-group-text"
                        style="cursor:pointer; pointer-events:auto;"
                        t-ref="PKeySelectFileButton"
                        onclick="document.getElementById('PKeyFileInput').click();">Обрати</span>
            </div>          
            <input id="PKeyFileInput" type="file" t-ref="PKeyFileInput" t-on-change="selectPrivateKeyFile"
                        multiple="false" hidden="1"/>
            <div class="input-group mb-3">
                <input type="password" id="PKeyPassword" t-ref="PKeyPassword"                               
                    placeholder="Пароль захисту ключа" class="form-control"
                    disabled="1"
                    aria-label="Пароль захисту ключа:" t-on-keydown="onKeyDown"/>
                <span class="input-group-text" t-ref="PKeyReadButton" 
                    style="cursor:pointer; pointer-events:auto;"
                    disabled="state.privateKeyReaded"
                    t-on-click="readPrivateKeyButtonClick">Зчитати</span>
            </div>          
            <!-- <input type="text" name="cert_id" class="form-control mb-2" placeholder="Сертификат ID"/> -->
            <button type="submit" disabled="1" t-ref="AuthButton" class="btn btn-primary w-100">Увійти по КЕП</button>
        </form>  
    </t>
</templates>