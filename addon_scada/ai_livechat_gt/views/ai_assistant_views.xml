        <record id="ai_livechat_gt_view_ai_assistant_kanban" model="ir.ui.view">
            <field name="name">AI Assistants Kanban</field>
            <field name="model">ai.assistant</field>
            <field name="arch" type="xml">
                <kanban create="false" edit="false" delete="false">
                    <field name="name"/>
                    <field name="partner_id"/>
                    
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card">
                                <div class="o_kanban_image">
                                    <img t-att-src="kanban_image('res.partner', 'image_128', record.partner_id.raw_value)" class="o_image_128_max" alt="Avatar"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <a type="open"><field name="name"/></a>
                                            </strong>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <div class="o_kanban_record_description">
                                                <a type="open"><field name="description"/></a>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="mt-2">
                                        <button type="object" name="action_start_chat" class="btn btn-primary btn-sm">
                                            <i class="fa fa-comments"/> Начать чат
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="ai_livechat_gt_action_view_ai_assistants" model="ir.actions.act_window">
            <field name="name">AI Assistants</field>
            <field name="res_model">ai.assistant</field>
            
            <field name="view_mode">kanban</field>
            
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Пока нет AI Ассистентов.
              </p><p>
                Здесь будет отображаться список всех AI Ассистентов.
              </p>
            </field>
        </record>

        <menuitem
            id="ai_livechat_gt_menu_ai_assistants"
            name="AI Assistants"
            parent="mail.menu_root_discuss"
            action="ai_livechat_gt_action_view_ai_assistants"
            sequence="10"/>
    </data>
</odoo>