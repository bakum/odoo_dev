<odoo>
    <data>
        <record id="view_xls_template_form" model="ir.ui.view">
            <field name="name">xml.xls.template.form</field>
            <field name="model">xml.xls.template</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="id" invisible="1"/>
                            <field name="report_type"/>
                            <field name="template_filename" invisible="1"/>
                            <field name="template_file" filename="template_filename"/>
                        </group>
                        <group colspan="4" style="width:100%">
                            <field name="template_file" widget="xls_preview" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_xls_template_tree" model="ir.ui.view">
            <field name="name">xml.xls.template.tree</field>
            <field name="model">xml.xls.template</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="report_type"/>
                </tree>
            </field>
        </record>

        <record id="action_xls_template" model="ir.actions.act_window">
            <field name="name">XLS Templates</field>
            <field name="res_model">xml.xls.template</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_xml_to_xls_root" name="Regulatory Reporting Converter"/>
        <menuitem id="menu_xml_to_xls_settings" parent="menu_xml_to_xls_root" name="Settings" sequence="30"/>
        <menuitem id="menu_xls_template" parent="menu_xml_to_xls_settings" name="XLS Report Templates" action="action_xls_template"/>
    </data>
</odoo>
