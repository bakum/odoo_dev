<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_xml_partner_form_inherit" model="ir.ui.view">
            <field name="name">xml.partner.form.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='vat']" position="after">
                        <field name="guid" readonly="1" invisible="not is_company"/>
                        <field name="is_organization"/>
                        <field name="okpo_code"/>
                        <field name="name_eng"/>        
                        <field name="address_eng"/>
                    </xpath>
                </data>
            </field>
        </record>

        <record id="view_xml_partner_search_inherit" model="ir.ui.view">
            <field name="name">xml.partner.search.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='type_company']" position="after">
                    <filter string="Organizations" name="is_organization" domain="[('is_organization','=',True)]"/>
                </xpath>
            </field>
        </record>

        <record id="partner_template_action" model="ir.actions.act_window">
            <field name="name">Partners</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="context">{'search_default_is_organization': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new partner
                </p>
            </field>
        </record>

        <menuitem id="menu_xml_partner" parent="menu_xml_to_xls_settings" name="Parners" action="xml_to_xls.partner_template_action"/>
    </data>
</odoo>