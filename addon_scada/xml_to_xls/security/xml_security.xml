<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_xml_to_xls" model="ir.module.category">
            <field name="name">XML Report Converter</field>
            <field name="description">Helps you convert report from xml to xlsx</field>
        </record>

        <record id="group_converter_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_xml_to_xls"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_converter_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_xml_to_xls"/>
            <field name="implied_ids" eval="[(4, ref('group_converter_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="converter_user_rule" model="ir.rule">
            <field name="name">Import XML</field>
            <field name="model_id" ref="model_xml_import"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('xml_to_xls.group_converter_user'))]"/>
        </record>
    </data>
</odoo>